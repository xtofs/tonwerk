<Project>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- the library's namespaces are used everywhere (library, apps, tests) -->
  <ItemGroup>
    <Using Include="Tonwerk.Theory" />
    <Using Include="Tonwerk.Synthesis" />
    <Using Include="Tonwerk.Wav" />
  </ItemGroup>

</Project>
